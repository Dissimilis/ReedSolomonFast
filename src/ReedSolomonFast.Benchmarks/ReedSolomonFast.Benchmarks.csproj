<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- The two most used managed Reed-Solomon packages, both scalar Backblaze ports. -->
    <PackageReference Include="ReedSolomon.NET" />
    <PackageReference Include="ReedSolomon" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReedSolomonFast\ReedSolomonFast.csproj" />
    <!-- Frozen pre-optimization snapshot, compiled as ReedSolomonFast.Baseline so both can load. -->
    <ProjectReference Include="..\ReedSolomonFast.Baseline\ReedSolomonFast.Baseline.csproj" Aliases="Baseline" />
  </ItemGroup>

</Project>
